# Server port
PORT=4000

# Allowed browser origin for CORS
CLIENT_ORIGIN="http://localhost:3000"

# Database Connection URL
# For local dev / SQLite: "file:./dev.db" (relative to prisma/schema.prisma)
# For Neon / Supabase / PostgreSQL: "postgresql://username:password@ep-cool-db.us-east-2.aws.neon.tech/venky_catering?sslmode=require"
DATABASE_URL="file:./dev.db"

# Admin Authentication Secret (change this in production)
ADMIN_JWT_SECRET="venky-yadav-catering-super-secret-key-2026"
ADMIN_DEFAULT_EMAIL="admin@venkyyadavcaterings.com"
ADMIN_DEFAULT_PASSWORD="ChangeThisPassword123!"

# Email Service (Optional for development - falls back to console logging)
EMAIL_SERVICE_API_KEY=""
EMAIL_FROM="no-reply@venkyyadavcaterings.com"
EMAIL_ADMIN_RECIPIENT="bookings@venkyyadavcaterings.com"
